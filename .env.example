# Diese Datei nach .env kopieren und lokal anpassen; echte Zugangsdaten nie committen.
# Die Binärdatei lädt keine .env-Datei: Compose env_file oder docker --env-file nutzen.
# Gemeinsame Konfiguration für go/ und quarkus/.
# Compose gibt der Quarkus-Variante eine eigene Client-ID und Topic-Präfix.

# Genau ein Endpunkt: erforderlich, solange API_URLS leer oder nicht gesetzt ist.
API_URL=http://192.168.1.10/api
# Mehrere benannte Endpunkte; nur ein nichtleerer Wert hat Vorrang vor API_URL.
API_URLS=
# Namen: ausschließlich A-Z, a-z, 0-9, _ und -; nur http:// oder https://.
# API_URLS=heating=http://device/api,hotwater=http://device/water

# Entweder Bearer-Token ODER Basic Auth, niemals beides.
API_TOKEN=
API_USER=
API_PASSWORD=
# Positive Go-Dauer und maximale Antwortgröße in Bytes.
API_TIMEOUT=15s
API_MAX_BODY_BYTES=1048576
# ACHTUNG: true deaktiviert Zertifikats-/Hostnamenprüfung (MITM-Risiko).
# Nur bewusst für lokale Geräte mit selbstsigniertem Zertifikat verwenden.
API_INSECURE_SKIP_VERIFY=false

# localhost im Container ist nicht der Host; erreichbaren Broker eintragen.
# Für das optionale Compose-Profil dev: tcp://mosquitto:1883
MQTT_BROKER=tcp://localhost:1883
# Für jede gleichzeitig laufende Instanz eine eindeutige ID wählen.
MQTT_CLIENT_ID=buderus-wp-to-mqtt
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC=buderus/wp
# Daten-QoS: 0, 1 oder 2; Availability verwendet höchstens QoS 1.
MQTT_QOS=0
MQTT_RETAIN=false
MQTT_PUBLISH_TIMEOUT=5s
# Retained online/offline auf MQTT_TOPIC/status, mit Last Will und Reconnect.
# Dieses Topic ist reserviert: Mapping-Ergebnisse mit genau diesem Topic werden abgelehnt.
# Der Status ist kein Nachweis aktueller REST-Daten.
MQTT_AVAILABILITY=true

# fields: JSON-Objekte rekursiv in Feld-Topics; passthrough: unveränderte Antwort.
MAPPING=fields
# Fünf Cron-Felder ohne Sekunden oder Deskriptoren.
# Keine Anführungszeichen: kompatibel mit Compose env_file und docker --env-file.
SCHEDULE=@every 60s
# Beispiel: SCHEDULE=*/5 * * * *
POLL_ON_START=true
# IANA-Zeitzone; Zeitzonendaten sind in der Binärdatei enthalten.
TZ=UTC

# debug, info, warn oder error; Ausgabe immer auf stdout.
LOG_LEVEL=info
# json oder text.
LOG_FORMAT=json
